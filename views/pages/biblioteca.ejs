<%- include('../partials/head', { title, active }) %>
<div class="panel">
    <div class="panel-grid">
        <section class="card user-card">
            <div class="user-card-header">
                <div>
                    <span class="eyebrow">Sessão simulada</span>
                    <h2>Bem-vindo de volta, <%= usuarioAtual.nome %></h2>
                    <p class="text-on-surface-variant mt-3">Sua biblioteca está pronta para consulta e reserva via estação RFID/NFC sem tela.</p>
                </div>
                <div class="user-avatar-badge"><%= usuarioAtual.nome.split(' ').map(n => n[0]).join('') %></div>
            </div>
            <div class="user-metrics">
                <div class="status-box">
                    <span>RA</span>
                    <strong><%= usuarioAtual.ra %></strong>
                </div>
                <div class="status-box">
                    <span>Curso</span>
                    <strong><%= usuarioAtual.curso %></strong>
                </div>
                <div class="status-box">
                    <span>Último acesso</span>
                    <strong><%= usuarioAtual.ultimoAcesso %></strong>
                </div>
            </div>
            <div class="action-buttons">
                <a href="/app/reservas/<%= usuarioAtual.id %>" class="primary-button">Minhas reservas</a>
                <a href="/app/emprestimos/<%= usuarioAtual.id %>" class="secondary-button">Meus empréstimos</a>
            </div>
        </section>

        <section class="card quick-info">
            <div class="metric-card">
                <h3>Estação RFID</h3>
                <p><strong><%= usuarioAtual.leitor %></strong></p>
                <p class="text-on-surface-variant mt-2">A estação de leitura opera sem tela para identificação e registro.</p>
            </div>
            <div class="metric-card">
                <h3>Local</h3>
                <p><strong><%= usuarioAtual.local %></strong></p>
                <p class="text-on-surface-variant mt-2">A biblioteca central é seu ponto de retirada e devolução.</p>
            </div>
            <div class="metric-card">
                <h3>Status</h3>
                <p><strong><%= usuarioAtual.status %></strong></p>
                <p class="text-on-surface-variant mt-2">Seu cadastro está ativo para operações de reserva.</p>
            </div>
        </section>
    </div>
</div>

<div class="cards-grid">
    <% if (livros && livros.length) { %>
        <% livros.forEach(livro => { %>
            <div class="card book-card">
                <img src="<%= livro.capa_url || 'https://via.placeholder.com/320x400?text=Capa+sem+imagem' %>" alt="Capa do livro <%= livro.titulo %>">
                <div>
                    <h2 class="book-title"><%= livro.titulo %></h2>
                    <p class="book-author"><%= livro.autor || 'Autor não informado' %></p>
                    <div class="meta-row">
                        <span><strong><%= livro.total_exemplares || 0 %></strong> exemplares</span>
                        <span><strong><%= livro.disponiveis || 0 %></strong> disponíveis</span>
                    </div>
                </div>
                <div class="stats-row">
                    <div class="stat-pill"><span>Emprestados</span><span class="stat-value"><%= livro.emprestados || 0 %></span></div>
                    <div class="stat-pill"><span>Reservados</span><span class="stat-value"><%= livro.reservados || 0 %></span></div>
                </div>
                <a href="/app/livro/<%= livro.id %>" class="button">Ver detalhes</a>
            </div>
        <% }) %>
    <% } else { %>
        <div class="card">
            <p>Nenhum livro encontrado no acervo.</p>
        </div>
    <% } %>
</div>
<%- include('../partials/footer') %>
