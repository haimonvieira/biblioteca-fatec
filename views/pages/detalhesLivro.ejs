<%- include('../partials/head', { title, active }) %>
<div class="panel">
    <div class="card">
        <div class="inline-row" style="align-items:center; justify-content:space-between; gap:16px;">
            <div>
                <h2><%= livro.titulo %></h2>
                <p class="book-author"><%= livro.autor || 'Autor não informado' %></p>
            </div>
            <a href="/app/biblioteca" class="secondary-button">Voltar ao acervo</a>
        </div>
    </div>
</div>

<div class="panel grid-2">
    <div class="card">
        <img src="<%= livro.capa_url || 'https://via.placeholder.com/320x460?text=Capa+sem+imagem' %>" alt="Capa do livro <%= livro.titulo %>" style="width:100%; border-radius:1rem; max-height:420px; object-fit:cover;">
        <div style="margin-top:1rem;">
            <p class="small-text">Editora: <strong><%= livro.editora || 'Não informada' %></strong></p>
            <p class="small-text">Ano: <strong><%= livro.ano_publicacao || '—' %></strong></p>
            <p class="small-text">ISBN: <strong><%= livro.isbn || '—' %></strong></p>
        </div>
        <div class="stats-row" style="margin-top:1rem;">
            <div class="stat-pill"><strong>Disponíveis:</strong> <%= livro.disponiveis || 0 %></div>
            <div class="stat-pill"><strong>Emprestados:</strong> <%= livro.emprestados || 0 %></div>
            <div class="stat-pill"><strong>Reservados:</strong> <%= livro.reservados || 0 %></div>
        </div>
    </div>

    <div class="card">
        <h3>Sobre a obra</h3>
        <p class="help-text"><%= livro.descricao || 'Nenhuma descrição disponível.' %></p>
        <div class="alert" style="margin-top:1.5rem;">
            Use o código NFC/RFID do aluno para reservar este livro. A reserva vale por 2 horas e pode ser retirada na biblioteca central.
        </div>
        <form action="/app/reserva/criar" method="post" style="margin-top: 1.5rem; display:grid; gap:1rem;">
            <input type="hidden" name="livro_id" value="<%= livro.id %>">
            <label>
                Código NFC/RFID do aluno
                <input type="text" name="codigo_nfc_aluno" placeholder="FATEC-ALUNO-123456" required>
            </label>
            <button type="submit" class="button">Reservar</button>
        </form>
    </div>
</div>

<div class="card table-card">
    <h3>Exemplares</h3>
    <table class="table">
        <thead>
            <tr>
                <th>RFID / Interno</th>
                <th>Localização</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <% if (exemplares && exemplares.length) { %>
                <% exemplares.forEach(exemplar => { %>
                    <tr>
                        <td><%= exemplar.codigo_rfid || exemplar.codigo_interno || '—' %></td>
                        <td><%= exemplar.localizacao || 'Não informada' %></td>
                        <td><span class="tag <%= buildStatusClass(exemplar.status) %>"><%= exemplar.status || '—' %></span></td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="3">Nenhum exemplar cadastrado para esta obra.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>
<%- include('../partials/footer') %>
