<%- include('../partials/head', { title, active }) %>
<div class="panel emprestimos-page">
    <div class="card">
        <div class="inline-row page-section-header" style="align-items:center; justify-content:space-between; width:100%;">
            <div>
                <h2>Empréstimos do Aluno</h2>
                <p class="small-text">Verifique o histórico e o status de cada livro retirado.</p>
            </div>
            <span class="badge gray">Aluno ID <%= aluno_id %></span>
        </div>
    </div>

    <div class="card table-card">
        <table class="table responsive-table">
            <thead>
                <tr>
                    <th>Livro</th>
                    <th>Exemplar</th>
                    <th>RFID</th>
                    <th>Retirada</th>
                    <th>Prevista</th>
                    <th>Devolução</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <% if (emprestimos && emprestimos.length) { %>
                    <% emprestimos.forEach(item => { %>
                        <tr>
                            <td><strong><%= item.titulo %></strong><br><span class="small-text"><%= item.autor || 'Autor não informado' %></span></td>
                            <td><%= item.codigo_interno || '—' %></td>
                            <td><%= item.codigo_rfid || '—' %></td>
                            <td><%= formatDateTime(item.data_retirada) %></td>
                            <td><%= formatDateTime(item.data_prevista_devolucao) %></td>
                            <td><%= formatDateTime(item.data_devolucao) %></td>
                            <td><span class="tag <%= buildStatusClass(item.status) %>"><%= item.status %></span></td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="7">Nenhum empréstimo encontrado para este aluno.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
<%- include('../partials/footer') %>
