<%- include('../partials/head', { title, active }) %>
<div class="panel reservas-page">
    <div class="card">
        <div class="inline-row page-section-header" style="align-items:center; justify-content:space-between; width:100%;">
            <div>
                <h2>Minhas Reservas</h2>
                <p class="small-text">Acompanhe suas reservas ativas, expiradas e canceladas.</p>
            </div>
            <span class="badge gray">Aluno ID <%= aluno_id %></span>
        </div>
    </div>

    <div class="card table-card">
        <table class="table responsive-table">
            <thead>
                <tr>
                    <th>Livro</th>
                    <th>Data da reserva</th>
                    <th>Validade</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <% if (reservas && reservas.length) { %>
                    <% reservas.forEach(reserva => { %>
                        <tr>
                            <td><strong><%= reserva.titulo %></strong><br><span class="small-text"><%= reserva.autor || 'Autor não informado' %></span></td>
                            <td><%= formatDateTime(reserva.data_reserva) %></td>
                            <td><%= formatDateTime(reserva.expira_em) %></td>
                            <td><span class="tag <%= buildStatusClass(reserva.status) %>"><%= reserva.status %></span></td>
                            <td>
                                <% if (reserva.status === 'ativa') { %>
                                    <form action="/app/reservas/cancelar" method="post" style="margin:0;">
                                        <input type="hidden" name="reserva_id" value="<%= reserva.id %>">
                                        <input type="hidden" name="aluno_id" value="<%= aluno_id %>">
                                        <button class="secondary-button" type="submit">Cancelar</button>
                                    </form>
                                <% } else { %>
                                    <span class="badge gray">Sem ação</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="5">Nenhuma reserva encontrada para este aluno.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
<%- include('../partials/footer') %>
