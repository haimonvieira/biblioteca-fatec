<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        'status-blocked': '#EF4444',
                        'surface-container-high': '#e7e8e9',
                        'inverse-surface': '#2e3132',
                        'secondary-container': '#da342f',
                        'background': '#f8f9fa',
                        'surface-tint': '#48626f',
                        'status-available': '#10B981',
                        'status-reserved': '#3B82F6',
                        'status-pending': '#F59E0B',
                        'status-finished': '#6B7280',
                        'primary': '#233d49',
                        'secondary': '#b61719',
                        'brand-red': '#B11116',
                        'sidebar-bg': '#365362',
                        'surface-container-low': '#f3f4f5',
                        'surface': '#f8f9fa',
                        'surface-dim': '#d9dadb',
                        'on-surface': '#191c1d',
                        'on-surface-variant': '#42484b',
                        'outline-variant': '#c2c7cb'
                    },
                    borderRadius: {
                        DEFAULT: '0.25rem',
                        lg: '0.5rem',
                        xl: '0.75rem',
                        full: '9999px'
                    },
                    spacing: {
                        'header-height': '56px',
                        'sidebar-width': '256px'
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f3f4f6; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        .material-symbols-outlined.fill { font-variation-settings: 'FILL' 1; }

        .sidebar-scroll::-webkit-scrollbar { width: 6px; }
        .sidebar-scroll::-webkit-scrollbar-track { background: transparent; }
        .sidebar-scroll::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.2); border-radius: 10px; }
        .sidebar-scroll::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.3); }

        .bento-card {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
            transition: all 0.3s ease;
        }
        .bento-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        }

        .card {
            background: #ffffff;
            border-radius: 1.25rem;
            border: 1px solid rgba(15, 23, 42, 0.06);
            box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
            padding: 1.5rem;
        }
        .panel {
            display: grid;
            gap: 1.5rem;
            margin-bottom: 1.75rem;
        }
        .panel-grid {
            display: grid;
            grid-template-columns: 1.7fr 1fr;
            gap: 1.5rem;
        }
        .user-card {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            min-height: 320px;
        }
        .user-card-header {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            align-items: flex-start;
        }
        .eyebrow {
            display: inline-flex;
            padding: 0.35rem 0.85rem;
            background: rgba(35, 61, 73, 0.08);
            border-radius: 999px;
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #233d49;
            font-weight: 700;
        }
        .user-card-header h2 {
            margin: 0;
            font-size: 1.8rem;
            line-height: 1.2;
            color: #102a43;
        }
        .user-avatar-badge {
            width: 70px;
            height: 70px;
            border-radius: 1.25rem;
            background: linear-gradient(180deg, #B11116 0%, #8b0f16 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 800;
            font-size: 1.4rem;
            box-shadow: 0 22px 60px rgba(15, 23, 42, 0.16);
        }
        .user-metrics {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 1rem;
        }
        .status-box {
            background: #f1f8ff;
            border-radius: 1rem;
            padding: 1rem;
        }
        .status-box span {
            display: block;
            font-size: 0.75rem;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 0.35rem;
        }
        .status-box strong {
            display: block;
            font-size: 1.1rem;
            color: #0f172a;
        }
        .action-buttons {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.75rem;
        }
        .primary-button,
        .secondary-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            border-radius: 0.95rem;
            font-weight: 700;
            padding: 0.95rem 1.1rem;
            text-decoration: none;
            transition: transform 0.15s ease, background 0.2s ease, color 0.2s ease;
        }
        .primary-button {
            background: #B11116;
            color: #ffffff;
        }
        .primary-button:hover {
            transform: translateY(-1px);
            background: #8a0e12;
        }
        .secondary-button {
            background: #f3f4f6;
            color: #0f172a;
        }
        .secondary-button:hover {
            background: #e2e8f0;
        }
        .quick-info {
            display: grid;
            gap: 1rem;
        }
        .quick-info .metric-card {
            padding: 1.25rem;
            min-height: 128px;
        }
        .quick-info .metric-card h3 {
            margin: 0 0 0.75rem;
            font-size: 1rem;
            color: #102a43;
        }
        .cards-grid {
            display: grid;
            gap: 1rem;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        }
        .book-card {
            display: flex;
            flex-direction: column;
            gap: 0.85rem;
            padding: 1rem;
            min-height: 100%;
        }
        .book-card img {
            width: 100%;
            height: 210px;
            object-fit: cover;
            border-radius: 1rem;
            background: #edf2f7;
        }
        .book-card h2 {
            font-size: 1.05rem;
            margin: 0;
            color: #102a43;
        }
        .book-card p {
            margin: 0;
            color: #475569;
        }
        .book-card .meta-row {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            align-items: center;
            color: #64748b;
            font-size: 0.92rem;
        }
        .book-card .stats-row {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            margin-top: 0.5rem;
        }
        .stats-row {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 0.75rem;
            margin-top: 1rem;
        }
        .stat-pill {
            background: #f8fafc;
            border-radius: 1rem;
            padding: 0.75rem 1rem;
            font-size: 0.86rem;
            color: #334155;
            display: inline-flex;
            gap: 0.5rem;
            align-items: center;
            justify-content: space-between;
            flex: 1 1 120px;
            min-width: 0;
        }
        .stat-pill span {
            display: inline-block;
        }
        .stat-value {
            font-weight: 700;
            color: #0f172a;
        }
        .button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            padding: 0.95rem 1rem;
            background: #365362;
            color: white;
            text-decoration: none;
            font-weight: 700;
            transition: background 0.2s ease;
        }
        .button:hover { background: #2f4d5b; }
        .secondary-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            padding: 0.85rem 1rem;
            background: #f8fafc;
            color: #102a43;
            border: 1px solid rgba(55, 65, 81, 0.14);
            text-decoration: none;
            font-weight: 700;
            transition: background 0.2s ease, border-color 0.2s ease;
        }
        .secondary-button:hover { background: #e2e8f0; border-color: rgba(55, 65, 81, 0.2); }
        .tag {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: 0.45rem 0.75rem;
            background: #e2e8f0;
            color: #102a43;
            font-size: 0.85rem;
            font-weight: 700;
        }
        .stats-row {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 0.75rem;
            margin-top: 1rem;
        }
        .stat-pill {
            border-radius: 1rem;
            background: #f0f7fb;
            padding: 1rem;
            box-shadow: inset 0 0 0 1px rgba(56, 103, 147, 0.08);
            color: #0f172a;
        }
        .book-author { color: #64748b; margin-top: 0.5rem; }
        .small-text { color: #64748b; font-size: 0.95rem; line-height: 1.7; }
        .help-text { color: #475569; line-height: 1.8; margin-top: 0.75rem; }
        .alert {
            border-radius: 1rem;
            border-left: 4px solid #365362;
            background: #f0f7fb;
            color: #0f172a;
            padding: 1rem 1rem 1rem 1rem;
            line-height: 1.6;
            margin-top: 1rem;
        }
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 0.9rem;
            border-radius: 999px;
            font-size: 0.8rem;
            font-weight: 700;
        }
        .badge.blue { background: #dbebff; color: #1e4db7; }
        .badge.green { background: #dcfce7; color: #166534; }
        .badge.gray { background: #f3f4f6; color: #475569; }
        .inline-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; }
        .grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
        .grid-2-left { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 1.25rem; align-items: start; }
        .grid-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
        .form-grid { display: grid; gap: 1rem; }
        .table-card { overflow-x: auto; }
        .table { width: 100%; border-collapse: collapse; background: #ffffff; }
        .table th, .table td {
            padding: 1rem 1rem;
            border-bottom: 1px solid #e2e8f0;
            text-align: left;
        }
        .table th { color: #102a43; font-weight: 700; }
        .table td { color: #475569; }
        .table tbody tr:hover { background: #f8fafc; }
        .table td .tag { display: inline-flex; }
        .cards-grid {
            display: grid;
            gap: 1rem;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        }

        @media (max-width: 1024px) {
            .panel-grid { grid-template-columns: 1fr; }
            .user-metrics { grid-template-columns: 1fr; }
            .action-buttons { grid-template-columns: 1fr; }
        }
        @media (max-width: 640px) {
            .panel { gap: 1rem; }
            .cards-grid { grid-template-columns: 1fr; }
            .sidebar.collapsed .collapse-button { right: 0.25rem; }
        }

        .sidebar {
            min-width: 256px;
            background: #365362;
            color: #ffffff;
            display: flex;
            flex-direction: column;
            position: relative;
            transition: width 0.25s ease;
        }
        .sidebar.collapsed {
            width: 72px;
            min-width: 72px;
        }
        .sidebar.collapsed .nav-text,
        .sidebar.collapsed .sidebar-description,
        .sidebar.collapsed .sidebar-footer-text,
        .sidebar.collapsed .brand-text {
            display: none;
        }
        .sidebar.collapsed .nav-item { justify-content: center; }
        .sidebar.collapsed .nav-item span:first-child { margin-right: 0; }
        .sidebar.collapsed .brand { justify-content: center; }

        .collapse-button {
            position: absolute;
            top: 50%;
            right: -1.35rem;
            transform: translateY(-50%);
            width: 2.5rem;
            height: 2.5rem;
            border-radius: 9999px;
            background: #365362;
            border: 1px solid rgba(255,255,255,0.12);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 10px 25px rgba(15, 23, 42, 0.12);
        }

        .sidebar-description {
            margin: 1rem 1rem 0;
            font-size: 0.9rem;
            color: rgba(255,255,255,0.75);
            line-height: 1.6;
        }
        .nav-item, .nav-toggle {
            display: flex;
            align-items: center;
            gap: 0.9rem;
            padding: 0.95rem 1rem;
            border-radius: 0.9rem;
            color: rgba(255,255,255,0.85);
            text-decoration: none;
            font-size: 0.95rem;
            transition: background 0.2s ease, color 0.2s ease;
            width: 100%;
            border: none;
            background: transparent;
            cursor: pointer;
        }
        .nav-toggle {
            justify-content: space-between;
            gap: 0.75rem;
        }
        .nav-toggle .material-symbols-outlined {
            transition: transform 0.2s ease;
        }
        .nav-toggle.open .material-symbols-outlined {
            transform: rotate(90deg);
        }
        .submenu {
            overflow: hidden;
            max-height: 0;
            transition: max-height 0.25s ease;
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
            margin-top: 0.5rem;
            padding-left: 0.5rem;
        }
        .submenu.open {
            max-height: 500px;
        }
        .submenu .nav-item {
            padding-left: 1.25rem;
            background: rgba(255,255,255,0.04);
        }
        .submenu .nav-item:hover {
            background: rgba(255,255,255,0.14);
        }
        .nav-item:hover { background: rgba(255,255,255,0.1); color: #ffffff; }
        .nav-item.active { background: rgba(255,255,255,0.15); color: #ffffff; }

        .sidebar-footer { padding: 1.5rem 1.25rem 1.5rem; border-top: 1px solid rgba(255,255,255,0.1); }
        .sidebar-footer-text { font-size: 0.68rem; color: rgba(255,255,255,0.72); text-transform: uppercase; letter-spacing: 0.12em; }

        @media (max-width: 1024px) {
            .sidebar { width: 100%; min-width: auto; }
            .sidebar.collapsed { width: 100%; }
            .collapse-button { right: 0.5rem; }
        }

        .bg-brand-red { background-color: #B11116; }
    </style>
</head>
<body class="text-on-surface antialiased overflow-hidden h-screen flex flex-col bg-surface">
<header class="bg-brand-red h-[56px] flex items-center justify-between px-6 z-20 shrink-0 text-white shadow-md">
    <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-3xl font-bold">share</span>
        <span class="font-semibold text-lg tracking-tight">Conecta</span>
    </div>
    <div class="flex items-center gap-3">
        <span class="hidden md:block text-sm">Olá, <%= usuarioAtual?.nome || 'Haimon' %>!</span>
        <img alt="Perfil do Usuário" class="w-8 h-8 rounded-full border border-white/20 object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDNZDRYaOcXr6sby5CgVII8TizHooJpsXiGXfDiIINIEFM_hBwKEKzTDshItL-PHcQBCi8n3P1kh0K87Vj4MNtAi7GnYj3V_lKRgMxED0fMwIWNOfMd_KsVcAqOXyx_X6JxlKtSe5b9qouCIYpQ7uk00mHv8p2bGIqkAxa1U0Lcm1GvY2GyLlg1OLxXpxQLE7kvg65nyBi9-jmENW8aLmGB5xvCM3QfgnAOxulCBOOePinr7iVj9p30eD-SGJPxX21o1hUfpTGWDzk">
    </div>
</header>
<div class="flex flex-1 overflow-hidden">
    <aside id="sidebar" class="sidebar">
        
        <nav class="flex-1 overflow-y-auto sidebar-scroll py-4 px-2 flex flex-col gap-1">
            <a href="/app/biblioteca" class="nav-item <%= active === 'home' ? 'active' : '' %>">
                <span class="material-symbols-outlined">home</span>
                <span class="nav-text">Home</span>
            </a>
            <button id="bibliotecaToggle" type="button" class="nav-toggle <%= ['biblioteca','reservas','emprestimos'].includes(active) ? 'active open' : '' %>">
                <span class="flex items-center gap-3">
                    <span class="material-symbols-outlined">local_library</span>
                    <span class="nav-text">Biblioteca</span>
                </span>
                <span class="material-symbols-outlined">chevron_right</span>
            </button>
            <div id="bibliotecaSubmenu" class="submenu <%= ['biblioteca','reservas','emprestimos'].includes(active) ? 'open' : '' %>">
                <a href="/app/biblioteca" class="nav-item <%= active === 'biblioteca' ? 'active' : '' %>">
                    <span class="material-symbols-outlined">dashboard</span>
                    <span class="nav-text">Acervo</span>
                </a>
                <a href="/app/reservas/<%= usuarioAtual.id %>" class="nav-item <%= active === 'reservas' ? 'active' : '' %>">
                    <span class="material-symbols-outlined">bookmark_added</span>
                    <span class="nav-text">Minhas Reservas</span>
                </a>
                <a href="/app/emprestimos/<%= usuarioAtual.id %>" class="nav-item <%= active === 'emprestimos' ? 'active' : '' %>">
                    <span class="material-symbols-outlined">import_contacts</span>
                    <span class="nav-text">Empréstimos</span>
                </a>
            </div>
            <div class="mt-2 mb-1 px-4"><div class="h-px bg-white/10 w-full"></div></div>
            <a href="#" class="nav-item">
                <span class="material-symbols-outlined">school</span>
                <span class="nav-text">Academies</span>
            </a>
            <a href="#" class="nav-item">
                <span class="material-symbols-outlined">event</span>
                <span class="nav-text">Eventos</span>
            </a>
            <a href="#" class="nav-item">
                <span class="material-symbols-outlined">emoji_events</span>
                <span class="nav-text">Extensão</span>
            </a>
            <a href="#" class="nav-item">
                <span class="material-symbols-outlined">lightbulb</span>
                <span class="nav-text">Projetos</span>
            </a>
            <a href="#" class="nav-item">
                <span class="material-symbols-outlined">science</span>
                <span class="nav-text">QTE</span>
            </a>
            <a href="#" class="nav-item">
                <span class="material-symbols-outlined">terminal</span>
                <span class="nav-text">Práticas</span>
            </a>
            <a href="#" class="nav-item">
                <span class="material-symbols-outlined">logout</span>
                <span class="nav-text">Sair</span>
            </a>
        </nav>
        <div class="sidebar-footer px-6">
            <div class="sidebar-footer-text">Fatec Registro</div>
        </div>
        <button id="toggleSidebarButton" class="collapse-button" type="button" aria-label="Colapsar barra lateral">
            <span class="material-symbols-outlined">chevron_left</span>
        </button>
    </aside>
    <main class="flex-1 overflow-y-auto bg-surface-container-low relative">
        <div class="absolute top-0 left-0 w-full h-64 bg-gradient-to-b from-white to-transparent pointer-events-none z-0"></div>
        <div class="absolute top-0 right-0 w-1/3 h-full bg-[url('data:image/svg+xml,%3Csvg width="60" height="60" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg"%3E%3Cg fill="none" fill-rule="evenodd"%3E%3Cg fill="%23e7e8e9" fill-opacity=".4"%3E%3Cpath d="M36 34v-16h2v16h-2zm-14 0h-16v-2h16v2zm-14 0v-16h2v16h-2z"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')] opacity-30 pointer-events-none z-0"></div>
        <div class="max-w-[1440px] mx-auto px-10 py-8 relative z-10 min-h-full flex flex-col">
            <div class="mb-8">
                <h1 class="text-2xl sm:text-3xl font-semibold text-primary mb-2"><%= title %></h1>
                <p class="text-sm sm:text-base text-on-surface-variant">Gerencie seus empréstimos, reservas e explore o acervo digital.</p>
            </div>
            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    var sidebar = document.getElementById('sidebar');
                    var toggle = document.getElementById('toggleSidebarButton');
                    if (sidebar && toggle) {
                        toggle.addEventListener('click', function () {
                            sidebar.classList.toggle('collapsed');
                            var icon = toggle.querySelector('.material-symbols-outlined');
                            if (icon) {
                                icon.textContent = sidebar.classList.contains('collapsed') ? 'chevron_right' : 'chevron_left';
                            }
                        });
                    }

                    var libraryToggle = document.getElementById('bibliotecaToggle');
                    var librarySubmenu = document.getElementById('bibliotecaSubmenu');
                    if (libraryToggle && librarySubmenu) {
                        libraryToggle.addEventListener('click', function () {
                            librarySubmenu.classList.toggle('open');
                            libraryToggle.classList.toggle('open');
                        });
                    }
                });
            </script>
